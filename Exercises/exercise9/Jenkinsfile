pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('Exercises/exercise9') {
                    echo 'Installing dependencies...'
                    sh '''
                        python3 --version
                        python3 -m pip install --user -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('Exercises/exercise9') {
                    echo 'Running tests...'
                    sh 'python3 -m unittest discover -s .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Exercises/exercise9') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p "${WORKSPACE}/python-app-deploy"
                        cp app.py "${WORKSPACE}/python-app-deploy/"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('Exercises/exercise9') {
                    echo 'Running application...'
                    sh '''
                        nohup python3 "${WORKSPACE}/python-app-deploy/app.py" \
                            > "${WORKSPACE}/python-app-deploy/app.log" 2>&1 &
                        echo $! > "${WORKSPACE}/python-app-deploy/app.pid"
                    '''
                }
            }
        }

        stage('Test Application') {
            steps {
                dir('Exercises/exercise9') {
                    echo 'Testing application...'
                    sh 'python3 test_app.py'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }

        always {
            sh '''
                if [ -f "${WORKSPACE}/python-app-deploy/app.pid" ]; then
                    kill "$(cat "${WORKSPACE}/python-app-deploy/app.pid")" || true
                fi
            '''
        }
    }
}